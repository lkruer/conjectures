Bounty.Construction196.permFun_injective : Function.Injective Bounty.Construction196.permFun
theorem Bounty.Construction196.permFun_injective : Function.Injective Bounty.Construction196.permFun :=
fun ⦃i j⦄ h =>
  let t := i + j + 1;
  have hlen := Bounty.Construction196.stage_length t;
  have hi :=
    lt_of_lt_of_le
      (have this := id (Decidable.byContradiction fun a => Bounty.Construction196.permFun_injective._proof_1_1 a);
      this)
      hlen;
  have hj :=
    lt_of_lt_of_le
      (have this := id (Decidable.byContradiction fun a => Bounty.Construction196.permFun_injective._proof_1_2 a);
      this)
      hlen;
  have hv :=
    Eq.trans (Eq.symm (Bounty.Construction196.permFun_agrees t i hi))
      (Eq.trans h (Bounty.Construction196.permFun_agrees t j hj));
  have hidx := congrArg (fun x => List.idxOf x ↑(Bounty.Construction196.stage t)) hv;
  Eq.mp
    (congr (congrArg Eq ((fun i h => List.Nodup.idxOf_getElem (Bounty.Construction196.stage t).property.left i h) i hi))
      ((fun i h => List.Nodup.idxOf_getElem (Bounty.Construction196.stage t).property.left i h) j hj))
    hidx
