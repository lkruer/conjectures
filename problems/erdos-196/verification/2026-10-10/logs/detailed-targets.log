theorem Bounty.Construction196.finite_extension : ∀ (P : List ℕ),
  Bounty.Construction196.Good P → ∀ (F : Finset ℕ), ∃ Q, Bounty.Construction196.Good Q ∧ P <+: Q ∧ ∀ x ∈ F, x ∈ Q :=
fun P hP F =>
  And.casesOn hP fun hPN right =>
    And.casesOn right fun hPC right =>
      Exists.casesOn right fun e₀ he₀ =>
        let e := Bounty.Construction196.adapt P e₀;
        have he := Bounty.Construction196.adapt_compatible he₀;
        have hae := fun x x_1 x_2 hn ha hw => Bounty.Construction196.adapt_old hn ha hw;
        Exists.casesOn (Bounty.Construction196.saturated_exists P e (P.toFinset ∪ F)) fun A h =>
          And.casesOn h fun hseed hs =>
            Exists.casesOn (Bounty.Construction196.sorted_block e P A) fun B h =>
              And.casesOn h fun hBN right =>
                And.casesOn right fun hB ho =>
                  have hPA := fun x hx => hseed (Finset.mem_union_left F (List.mem_toFinset.mpr hx));
                  have hcover := fun x =>
                    Eq.mpr (id (congrArg (fun _a => _a ↔ x ∈ A) (propext List.mem_append)))
                      (Eq.mpr (id (congrArg (fun _a => x ∈ P ∨ _a ↔ x ∈ A) (propext (hB x))))
                        { mp := fun a => Or.casesOn a (fun hp => hPA x hp) fun h => And.casesOn h fun ha right => ha,
                          mpr := fun ha => if hp : x ∈ P then Or.inl hp else Or.inr ⟨ha, hp⟩ });
                  have hsep := fun a ha b hb hab =>
                    Eq.ndrec (motive := fun b => b ∈ B → False) (fun hb => ((hB a).mp hb).right ha) hab hb;
                  Exists.intro (P ++ B)
                    ⟨⟨List.nodup_append.mpr ⟨hPN, ⟨hBN, hsep⟩⟩,
                        ⟨Bounty.Construction196.extend_closed hPC he hae hs hB ho,
                          Exists.intro (Bounty.Construction196.nextPreference P e)
                            (Bounty.Construction196.extend_compatible he hae hs hcover ho)⟩⟩,
                      ⟨List.prefix_append P B, fun x hx =>
                        (hcover x).mpr (hseed (Finset.mem_union_right P.toFinset hx))⟩⟩
