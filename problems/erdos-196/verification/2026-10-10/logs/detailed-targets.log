theorem Bounty.Construction196.permFun_no_four : ∀ (i j k l : ℕ),
  i < j →
    j < k →
      k < l →
        Bounty.Construction196.permFun i + Bounty.Construction196.permFun k = 2 * Bounty.Construction196.permFun j →
          Bounty.Construction196.permFun j + Bounty.Construction196.permFun l = 2 * Bounty.Construction196.permFun k →
            False :=
fun i j k l hij hjk hkl h₁ h₂ =>
  let t := l + 1;
  have hlen := Bounty.Construction196.stage_length t;
  have hi :=
    lt_of_lt_of_le
      (have this :=
        id (Decidable.byContradiction fun a => Bounty.Construction196.permFun_no_four._proof_1_1 i j k l hij hjk hkl a);
      this)
      hlen;
  have hj :=
    lt_of_lt_of_le
      (have this :=
        id (Decidable.byContradiction fun a => Bounty.Construction196.permFun_no_four._proof_1_2 i j k l hjk hkl a);
      this)
      hlen;
  have hk :=
    lt_of_lt_of_le
      (have this :=
        id (Decidable.byContradiction fun a => Bounty.Construction196.permFun_no_four._proof_1_3 i j k l hkl a);
      this)
      hlen;
  have hl :=
    lt_of_lt_of_le
      (have this := id (Decidable.byContradiction fun a => Bounty.Construction196.permFun_no_four._proof_1_4 i j k l a);
      this)
      hlen;
  have hP := (Bounty.Construction196.stage t).property;
  have hab :=
    Eq.mpr
      (id
        (congrArg
          (fun _a =>
            Bounty.Construction196.Before (↑(Bounty.Construction196.stage t)) _a (Bounty.Construction196.permFun j))
          (Bounty.Construction196.permFun_agrees t i hi)))
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              Bounty.Construction196.Before (↑(Bounty.Construction196.stage t)) (↑(Bounty.Construction196.stage t))[i]
                _a)
            (Bounty.Construction196.permFun_agrees t j hj)))
        (Bounty.Construction196.before_get hP.left hi hj hij));
  have hbc :=
    Eq.mpr
      (id
        (congrArg
          (fun _a =>
            Bounty.Construction196.Before (↑(Bounty.Construction196.stage t)) _a (Bounty.Construction196.permFun k))
          (Bounty.Construction196.permFun_agrees t j hj)))
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              Bounty.Construction196.Before (↑(Bounty.Construction196.stage t)) (↑(Bounty.Construction196.stage t))[j]
                _a)
            (Bounty.Construction196.permFun_agrees t k hk)))
        (Bounty.Construction196.before_get hP.left hj hk hjk));
  have hcd :=
    Eq.mpr
      (id
        (congrArg
          (fun _a =>
            Bounty.Construction196.Before (↑(Bounty.Construction196.stage t)) _a (Bounty.Construction196.permFun l))
          (Bounty.Construction196.permFun_agrees t k hk)))
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              Bounty.Construction196.Before (↑(Bounty.Construction196.stage t)) (↑(Bounty.Construction196.stage t))[k]
                _a)
            (Bounty.Construction196.permFun_agrees t l hl)))
        (Bounty.Construction196.before_get hP.left hk hl hkl));
  Bounty.Construction196.Before.asymm hcd
    (hP.right.left (Bounty.Construction196.permFun i) (Bounty.Construction196.permFun j)
      (Bounty.Construction196.permFun k) (Bounty.Construction196.permFun l) hab hbc h₁ h₂)
